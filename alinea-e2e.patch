diff --git a/.github/workflows/e2e.yml b/.github/workflows/e2e.yml
new file mode 100644
index 0000000..74a1279
--- /dev/null
+++ b/.github/workflows/e2e.yml
@@ -0,0 +1,126 @@
+name: E2E Playwright
+
+on:
+  pull_request:
+    branches: [main, master]
+  push:
+    branches: [main, master]
+  schedule:
+    - cron: '0 18 * * *' # 01:00 WIB setiap hari (regresi malam)
+  workflow_dispatch: # tombol "Run workflow" manual di tab Actions
+
+concurrency:
+  group: e2e-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  e2e:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    services:
+      mysql:
+        image: mysql:8.0
+        env:
+          MYSQL_ROOT_PASSWORD: root
+          MYSQL_DATABASE: alinea_e2e
+        ports: ['3306:3306']
+        options: >-
+          --health-cmd="mysqladmin ping -proot"
+          --health-interval=10s
+          --health-timeout=5s
+          --health-retries=10
+
+    # Env asli menang atas file .env, jadi .env.example cukup disalin apa adanya.
+    env:
+      APP_ENV: local
+      APP_DEBUG: 'false'
+      APP_URL: http://127.0.0.1:8000
+      APP_LOCALE: en
+      DB_CONNECTION: mysql
+      DB_HOST: 127.0.0.1
+      DB_PORT: 3306
+      DB_DATABASE: alinea_e2e
+      DB_USERNAME: root
+      DB_PASSWORD: root
+      SESSION_DRIVER: file
+      CACHE_STORE: file
+      QUEUE_CONNECTION: sync
+      BROADCAST_CONNECTION: log
+      MAIL_MAILER: log
+      # Password akun uji untuk database sementara di runner ini (bukan akun production).
+      E2E_PASSWORD: ${{ secrets.E2E_PASSWORD || 'e2e-Pass-2026' }}
+      E2E_BASE_URL: http://127.0.0.1:8000
+
+    steps:
+      - name: 1. Checkout
+        uses: actions/checkout@v4
+
+      - name: 2. Setup PHP 8.4
+        # composer.lock memakai Symfony 8.x yang mewajibkan PHP >= 8.4.1
+        uses: shivammathur/setup-php@v2
+        with:
+          php-version: '8.4'
+          extensions: mbstring, intl, pdo_mysql, gd, zip, bcmath, exif
+          coverage: none
+
+      - name: 3. Install dependency PHP
+        run: composer install --no-interaction --prefer-dist --no-progress
+
+      - name: 4. Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      - name: 5. Install dependency JS dan build aset Vite
+        run: |
+          npm ci
+          npm run build
+
+      - name: 6. Siapkan Laravel (key, migrasi, data uji)
+        run: |
+          cp .env.example .env
+          php artisan key:generate
+          php artisan migrate:fresh --seed --seeder=E2ESeeder --force
+          php artisan storage:link
+
+      - name: 7. Jalankan server Laravel
+        run: |
+          PHP_CLI_SERVER_WORKERS=4 php artisan serve --host=127.0.0.1 --port=8000 > storage/logs/serve.log 2>&1 &
+          for i in $(seq 1 30); do
+            curl -sf http://127.0.0.1:8000/login > /dev/null && exit 0
+            sleep 1
+          done
+          echo "Server tidak merespons"; cat storage/logs/serve.log; exit 1
+
+      - name: 8. Install browser Playwright
+        run: npx playwright install --with-deps chromium
+
+      - name: 9. Jalankan test E2E
+        run: npx playwright test
+
+      - name: 10. Ringkasan hasil di tab Summary
+        if: always()
+        run: node scripts/e2e-summary.mjs >> "$GITHUB_STEP_SUMMARY"
+
+      - name: 11. Upload laporan HTML dan trace
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: playwright-report
+          path: |
+            playwright-report/
+            test-results/
+          retention-days: 14
+
+      - name: 12. Upload log Laravel (jika gagal)
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: laravel-logs
+          path: storage/logs/
+          retention-days: 7
