+  await expect(page.locator('#feed-panel').getByText(pesan)).toBeVisible();
+
+  // Tetap ada setelah reload = benar-benar tersimpan di database
+  await page.reload();
+  await expect(page.locator('#feed-panel').getByText(pesan)).toBeVisible();
+});
