document.addEventListener('DOMContentLoaded', () => {
    const authUser = window.authUser || { id: null, name: 'Saya', initial: 'S', avatar_url: '' };
    const apiBase = '/api/chat';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    let searchTimeout = null;

    function apiHeaders(extra = {}) {
        return {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': csrfToken,
            ...extra,
        };
    }

    let conversations = [];
    let currentMessages = [];
    let currentConversationId = null;
    let cursor = null;
    let loadingMessages = false;
    let typingTimeout = null;
    let activeSubscriptions = [];

    const emojis = ['😀', '😂', '😍', '🥰', '😎', '🤔', '😅', '🙏', '👍', '❤️', '🔥', '🎉', '📚', '✨', '💬', '😭', '🥺', '😊', '👀', '💪'];

    async function fetchConversations() {
        try {
            const res = await fetch(`${apiBase}/conversations`, { headers: apiHeaders() });
            if (!res.ok) return;
            const data = await res.json();
            conversations = data;
            renderSidebar();
            subscribeToConversations();
        } catch (e) {
            console.error('Failed to fetch conversations', e);
        }
    }

    function renderSidebar() {
        const list = document.getElementById('chatList');
        list.innerHTML = '';

        conversations.data?.forEach(conv => {
            const user = conv.other_user;
            if (!user) return;

            const div = document.createElement('div');
            div.id = `item-${conv.id}`;
            div.className = `chat-item flex gap-3 px-3 py-2 rounded-xl cursor-pointer hover:bg-gray-50 transition${currentConversationId === conv.id ? ' active' : ''}`;
            div.dataset.conversationId = conv.id;
            div.innerHTML = `
                <div class="shrink-0">
                    ${avatarHTML(user, 'w-11 h-11')}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="chat-name font-semibold text-sm truncate">${escapeHtml(user.name)}</p>
                    <p class="sidebar-preview text-xs text-gray-400 truncate">${conv.last_message ? escapeHtml(conv.last_message.content) : 'Belum ada pesan'}</p>
                </div>
                <div class="flex flex-col items-end gap-1 shrink-0">
                    ${conv.last_message ? `<span class="sidebar-time text-xs text-gray-400">${formatTime(conv.last_message.created_at)}</span>` : ''}
                    ${conv.unread_count > 0 ? `<span class="unread-badge">${conv.unread_count}</span>` : ''}
                </div>
            `;
            div.addEventListener('click', () => openConversation(conv.id));
            list.appendChild(div);
        });

        updateTotalBadge();
    }

    async function openConversation(id) {
        const prev = document.querySelector(`.chat-item.active`);
        prev?.classList.remove('active');
        currentConversationId = id;
        document.getElementById(`item-${id}`)?.classList.add('active');

        const conv = conversations.data?.find(c => c.id === id);
        if (conv?.other_user) {
            document.getElementById('chatName').textContent = conv.other_user.name;
            document.getElementById('chatAvatarWrapper').innerHTML = avatarHTML(conv.other_user, 'w-11 h-11');
        }

        document.getElementById('chatEmpty')?.classList.add('hidden');
        document.getElementById('chatHeader')?.classList.remove('hidden');
        document.getElementById('chatBox')?.classList.remove('hidden');

        markAsRead(id);
        await loadMessages(id);
        subscribeToConversation(id);

        document.getElementById('messageInput')?.focus();
    }

    async function loadMessages(conversationId, isLoadMore = false) {
        if (loadingMessages) return;
        loadingMessages = true;

        try {
            let url = `${apiBase}/conversations/${conversationId}/messages`;
            if (isLoadMore && cursor) {
                url = cursor;
            }
            const res = await fetch(url, { headers: apiHeaders() });
            if (!res.ok) return;

            const data = await res.json();
            cursor = data.links?.next || null;
            const messages = data.data || [];

            if (isLoadMore) {
                currentMessages = [...messages.reverse(), ...currentMessages];
            } else {
                currentMessages = messages.reverse();
            }

            renderMessages(isLoadMore);
        } catch (e) {
            console.error('Failed to load messages', e);
        } finally {
            loadingMessages = false;
        }
    }

    function renderMessages(isLoadMore = false) {
        const chatBox = document.getElementById('chatBox');

        chatBox.innerHTML = '';

        if (cursor) {
            const loadMore = document.createElement('div');
            loadMore.className = 'text-center py-2';
            const btn = document.createElement('button');
            btn.className = 'text-xs text-blue-500 hover:underline';
            btn.textContent = 'Muat pesan sebelumnya';
            btn.addEventListener('click', async () => {
                await loadMessages(currentConversationId, true);
            });
            loadMore.appendChild(btn);
            chatBox.appendChild(loadMore);
        }

        currentMessages.forEach(msg => {
            const isRight = msg.is_mine;
            const wrapper = document.createElement('div');
            wrapper.className = (isRight ? 'flex flex-col items-end' : 'flex flex-col items-start') + ' bubble-in';
            wrapper.dataset.messageId = msg.id;

            if (isRight) {
                const row = document.createElement('div');
                row.className = 'flex items-end gap-2';

                const bubble = document.createElement('div');
                bubble.className = 'bg-[#FFDDAF] border border-[#444] px-4 py-2 rounded-2xl text-sm max-w-xs';
                bubble.textContent = msg.content || '';

                row.appendChild(bubble);
                row.appendChild(document.createRange().createContextualFragment(avatarHTML(authUser, 'w-8 h-8')));
                wrapper.appendChild(row);

                const meta = document.createElement('div');
                meta.className = 'flex items-center gap-1 mt-1 pr-10';

                const timeEl = document.createElement('span');
                timeEl.className = 'msg-time';
                timeEl.textContent = formatTime(msg.created_at);

                meta.appendChild(timeEl);
                wrapper.appendChild(meta);

            } else {
                const bubble = document.createElement('div');
                bubble.className = 'bg-white shadow-sm border border-gray-100 px-4 py-2 rounded-2xl text-sm max-w-xs';
                bubble.textContent = msg.content || '';
                wrapper.appendChild(bubble);

                const timeEl = document.createElement('p');
                timeEl.className = 'msg-time';
                timeEl.textContent = formatTime(msg.created_at);
                wrapper.appendChild(timeEl);
            }

            if (msg.reactions?.length > 0) {
                const reactionsRow = document.createElement('div');
                reactionsRow.className = 'flex gap-1 mt-1';
                msg.reactions.forEach(r => {
                    const span = document.createElement('span');
                    span.className = 'text-xs bg-gray-100 px-1.5 py-0.5 rounded-full';
                    span.textContent = `${r.emoji} ${r.count}`;
                    reactionsRow.appendChild(span);
                });
                wrapper.appendChild(reactionsRow);
            }

            chatBox.appendChild(wrapper);
        });

        if (!isLoadMore) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    }

    async function sendMessage() {
        const input = document.getElementById('messageInput');
        const text = input.value.trim();
        if (!text || !currentConversationId) return;

        try {
            const res = await fetch(`${apiBase}/conversations/${currentConversationId}/messages`, {
                method: 'POST',
                headers: { ...apiHeaders(), 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: text, type: 'text' }),
            });

            if (!res.ok) return;

            const newMsg = await res.json();
            currentMessages.push(newMsg.data);
            renderMessages();
            input.value = '';

            const item = document.getElementById(`item-${currentConversationId}`);
            const preview = item?.querySelector('.sidebar-preview');
            if (preview) preview.textContent = text;

            emitTyping(false);
        } catch (e) {
            console.error('Failed to send message', e);
        }
    }

    async function markAsRead(conversationId) {
        try {
            await fetch(`${apiBase}/conversations/${conversationId}/read`, {
                method: 'POST',
                headers: apiHeaders(),
            });
        } catch (e) { /* ignore */ }
    }

    function emitTyping(isTyping) {
        if (!currentConversationId) return;
        fetch(`${apiBase}/conversations/${currentConversationId}/typing`, {
            method: 'POST',
            headers: { ...apiHeaders(), 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_typing: isTyping }),
        }).catch(() => {});
    }

    function subscribeToConversations() {
        activeSubscriptions.forEach(s => {
            if (typeof s.leave === 'function') s.leave();
        });
        activeSubscriptions = [];

        conversations.data?.forEach(conv => {
            subscribeToConversation(conv.id);
        });
    }

    function subscribeToConversation(id) {
        if (!window.Echo) return;

        if (activeSubscriptions.find(s => s.name === `conversation.${id}`)) return;

        const channel = window.Echo.private(`conversation.${id}`);
        channel.name = `conversation.${id}`;

        channel.listen('.MessageSent', (e) => {
            if (e.sender_id === authUser.id) return;
            if (currentConversationId === id) {
                currentMessages.push(e);
                renderMessages();
                markAsRead(id);
            }
            fetchConversations();
        });

        channel.listen('.MessageDeleted', (e) => {
            currentMessages = currentMessages.filter(m => m.id !== e.message_id);
            renderMessages();
        });

        channel.listen('.ReactionUpdated', () => {
            if (currentConversationId === id) {
                loadMessages(id);
            }
        });

        channel.listen('.ConversationRead', () => {
            // Future: update read receipt UI
        });

        channel.listen('.TypingIndicator', (e) => {
            if (e.user_id === authUser.id) return;
            const indicator = document.getElementById('typingIndicator');
            if (e.is_typing) {
                indicator.classList.remove('hidden');
            } else {
                indicator.classList.add('hidden');
            }
        });

        activeSubscriptions.push(channel);
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    function formatTime(isoString) {
        const d = new Date(isoString);
        return d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0');
    }

    function avatarHTML(user, size) {
        if (user.avatar_url) {
            return `<img src="${user.avatar_url}" alt="avatar" class="${size} rounded-full border-2 border-[#444] object-cover flex-shrink-0">`;
        }
        return `<div class="${size} rounded-full bg-gradient-to-br from-[#FFDDAF] to-[#C7E7FF] border-2 border-[#444] flex items-center justify-center text-[#444] font-bold text-xs flex-shrink-0">${escapeHtml(user.initial || user.name?.charAt(0)?.toUpperCase() || '?')}</div>`;
    }

    function updateTotalBadge() {
        const total = conversations.data?.reduce((sum, c) => sum + (c.unread_count || 0), 0) || 0;
        const el = document.getElementById('totalUnread');
        if (el) {
            el.textContent = total;
            el.style.display = total > 0 ? '' : 'none';
        }
    }

    function filterChats(query) {
        const q = query.toLowerCase();
        conversations.data?.forEach(conv => {
            const el = document.getElementById(`item-${conv.id}`);
            if (!el) return;
            const name = conv.other_user?.name?.toLowerCase() || '';
            el.style.display = name.includes(q) ? '' : 'none';
        });
    }

    function buildEmojiPicker() {
        const picker = document.getElementById('emojiPicker');
        if (!picker) return;
        picker.innerHTML = '';
        emojis.forEach(e => {
            const btn = document.createElement('span');
            btn.className = 'emoji-btn';
            btn.textContent = e;
            btn.onclick = () => {
                document.getElementById('messageInput').value += e;
                document.getElementById('messageInput').focus();
                toggleEmoji(false);
            };
            picker.appendChild(btn);
        });
    }

    function toggleEmoji(forceClose) {
        const picker = document.getElementById('emojiPicker');
        if (!picker) return;
        if (forceClose === false || picker.classList.contains('open')) {
            picker.classList.remove('open');
        } else {
            picker.classList.add('open');
        }
    }

    // ── New Conversation Modal ───────────────────────────
    function openNewChatModal() {
        document.getElementById('newChatModal')?.classList.remove('hidden');
        document.getElementById('newChatSearch')?.focus();
        document.getElementById('newChatResults').innerHTML = '';
        document.getElementById('newChatEmpty').classList.add('hidden');
    }

    function closeNewChatModal() {
        document.getElementById('newChatModal')?.classList.add('hidden');
        document.getElementById('newChatSearch').value = '';
        document.getElementById('newChatResults').innerHTML = '';
    }

    async function searchUsers(query) {
        if (query.length < 1) {
            document.getElementById('newChatResults').innerHTML = '';
            document.getElementById('newChatEmpty').classList.add('hidden');
            return;
        }

        try {
            const res = await fetch(`/api/users?search=${encodeURIComponent(query)}`, {
                headers: apiHeaders(),
                credentials: 'same-origin',
            });
            if (!res.ok) return;
            const users = await res.json();
            const results = document.getElementById('newChatResults');
            results.innerHTML = '';

            const filtered = users.filter(u => u.id !== authUser.id);

            if (filtered.length === 0) {
                document.getElementById('newChatEmpty').classList.remove('hidden');
                return;
            }

            document.getElementById('newChatEmpty').classList.add('hidden');

            filtered.forEach(user => {
                const div = document.createElement('div');
                div.className = 'flex items-center gap-3 px-3 py-2 rounded-xl cursor-pointer hover:bg-gray-50 transition';
                div.innerHTML = `
                    <div class="shrink-0">
                        ${avatarHTML(user, 'w-10 h-10')}
                    </div>
                    <div>
                        <p class="font-semibold text-sm">${escapeHtml(user.name)}</p>
                        <p class="text-xs text-gray-400">@${escapeHtml(user.username || '')}</p>
                    </div>
                `;
                div.addEventListener('click', () => startNewConversation(user.id, user.name));
                results.appendChild(div);
            });
        } catch (e) {
            console.error('Failed to search users', e);
        }
    }

    async function startNewConversation(userId, userName) {
        closeNewChatModal();

        try {
            const res = await fetch(`${apiBase}/conversations`, {
                method: 'POST',
                headers: { ...apiHeaders(), 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: userId }),
            });
            if (!res.ok) return;

            await fetchConversations();

            const conv = conversations.data?.find(c => c.other_user?.id === userId);
            if (conv) {
                openConversation(conv.id);
            }
        } catch (e) {
            console.error('Failed to start conversation', e);
        }
    }

    document.getElementById('backBtn')?.addEventListener('click', () => history.back());
    document.getElementById('sendBtn')?.addEventListener('click', sendMessage);

    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', () => filterChats(searchInput.value));
    }

    const msgInput = document.getElementById('messageInput');
    if (msgInput) {
        msgInput.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        msgInput.addEventListener('input', () => {
            clearTimeout(typingTimeout);
            emitTyping(true);
            typingTimeout = setTimeout(() => emitTyping(false), 2000);
        });
    }

    document.getElementById('emojiToggle')?.addEventListener('click', toggleEmoji);
    document.getElementById('newChatBtn')?.addEventListener('click', openNewChatModal);
    document.getElementById('closeNewChat')?.addEventListener('click', closeNewChatModal);

    const newChatSearch = document.getElementById('newChatSearch');
    if (newChatSearch) {
        newChatSearch.addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => searchUsers(newChatSearch.value.trim()), 300);
        });
        newChatSearch.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeNewChatModal();
        });
    }

    document.addEventListener('click', e => {
        const toggle = document.getElementById('emojiToggle');
        const picker = document.getElementById('emojiPicker');
        if (toggle && picker && !toggle.contains(e.target) && !picker.contains(e.target)) {
            picker.classList.remove('open');
        }
    });

    buildEmojiPicker();
    fetchConversations();
});
